    </div>
  </OneColumn>
  <OneColumn>
    <div class="markdown">
      <h2 class="header space-y-6" id="tickets">Tickets</h2>
      <p>
        The morning program of the Industry Track requires a regular RustWeek
        ticket. The talks are open to all vistors of RustWeek to
        attend; priority access will be given to those with the add-on "Industry
        Track Expert Tables participation".
      </p>
      <p>
        To attend the Expert Tables in the afternoon, the add-on "Industry Track 
        Expert Tables participation" is required.
      </p>
      <ButtonGroup>
        <Button link="https://event.onliveevent.nl/rustweek-2027">
          Get ticket
        </Button>
      </ButtonGroup>
    </div>
  </OneColumn>
  <PeopleList title="Speakers" id="speakers" lead="" random={false}>
    {speakers.map((speaker: any) => (
      <Speaker talkId={speaker.talk.id} tile {...speaker} />
    ))}
  </PeopleList>
  <p class="container text-center" style="font-size: 1.6rem">
    Do you also want to speak at RustWeek? Our <a href="/cfp">Call for Proposals</a> is open!
  </p>
  <Sponsors id="sponsors">
    <div slot="header" class="markdown">
      <h2>Our 2026 Industry Track sponsors</h2>
      <p>
        Interested in sponsoring RustWeek 2027 and the Industry Track? <br />Download our <a
          target="_blank"
          href="/resources/sponsorship-prospectus-rustweek-2027.pdf"
          >Sponsorship prospectus</a
        > or <a href="mailto:sponsors@rustnl.org">contact us</a>
      </p>
    </div>
    <SponsorTier name="Expert Partners">
      <Sponsor
        name="Microsoft"
        tier="expert-partner"
        image="microsoft.svg"
        link="https://www.microsoft.com/"
      />
      <Sponsor
        name="RustJobs"
        tier="expert-partner"
        image="rustjobs.svg"
        link="https://rustjobs.dev/"
      />  
      <Sponsor
        name="Ferrous Systems"
        tier="expert-partner"
        image="ferrous.svg"
        link="https://ferrous-systems.com/"
      />
      <Sponsor
        name="Rocsys"
        tier="expert-partner"
        image="rocsys2025.png"
        link="https://www.rocsys.com/"
      />
      <Sponsor
        name="Corrode"
        tier="expert-partner"
        image="corrode.svg"
        link="https://corrode.dev/"
      />
      <Sponsor
        name="Volvo Cars"
        tier="expert-partner"
        image="volvo.png"
        link="https://www.volvocars.com/"
      />
      <Sponsor
        name="KDAB"
        tier="expert-partner"
        image="kdab.png"
        link="https://www.kdab.com/"
      />
    </SponsorTier>
    <SponsorTier name="Industry Partner">
      <Sponsor
        name="Rust Foundation"
        tier="industry-partner"
        image="rustfoundation.svg"
        link="https://rustfoundation.org/"
      />
      <Sponsor
        name="Technolution"
        tier="industry-partner"
        image="technolution.png"
        link="https://www.technolution.com/"
      />
      <Sponsor
        name="TMC"
        tier="industry-partner"
        image="tmc.png"
        link="https://www.themembercompany.com/"
      />
      <Sponsor
        name="Wyliodrin"
        tier="industry-partner"
        image="wyliodrin.svg"
        link="https://wyliodrin.com/"
      />
    </SponsorTier>
    <SponsorTier name="Powered by">
      <Sponsor
        name="Tweede golf"
        tier="industry-partner"
        image="tweede-golf-v2.png"
        link="https://tweedegolf.nl"
      />
      <Sponsor
        name="RustNL"
        tier="industry-partner"
        image="rustnl-logo.svg"
        link="/about"
      />
    </SponsorTier>
  </Sponsors>
  <Image src="/images/rustweek2026/flags.jpg" alt="Flags at RustWeek 2026" />
</HeroLayout>

<style>
  :global(#speakers .people) {
    margin-left: 10rem;
    margin-right: 10rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  :global(#speakers .people > .person) {
    width: 100%;
    max-width: 18rem;
    justify-self: center;
  }

  @media (max-width: 64rem) {
    :global(#speakers .people) {
      margin-left: 0;
      margin-right: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    :global(#speakers .people) {
      grid-template-columns: 1fr;
    }
  }
</style>
