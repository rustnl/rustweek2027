---
import HeroLayout from "../layouts/HeroLayout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Image from "../components/Image.astro";
import Speaker from "src/components/people/Speaker.astro";
import PeopleList from "src/components/people/PeopleList.astro";
import Sponsors from "src/components/sponsor/Sponsors.astro";
import SponsorTier from "src/components/sponsor/sponsor-tier.astro";
import Sponsor from "src/components/sponsor/sponsor.astro";
import { useData } from "../components/useData";
import { getCollection } from "astro:content";
import OneColumn from "src/components/OneColumn.astro";

const people = await getCollection("people");
const { jess } = useData(people);
const speakers = [jess];
---

<HeroLayout title="Industry Track" slidedeck="industry">
  <Fragment slot="hero">
    <div>
      <h1 class="font-display">Industry Track</h1>
      <h2>25 May 2027 — Utrecht, NL</h2>
    </div>
    <p>
      The must-attend track for decision makers exploring the adoption of Rust
      in their organisation.
    </p>
    <ButtonGroup style="cutout" align="left">
      <Button link="#schedule" ty="secondary">Schedule</Button>
      <Button link="https://event.onliveevent.nl/rustweek-2027">Tickets</Button>
    </ButtonGroup>
  </Fragment>
  <OneColumn>
    <div class="markdown">
      <h2 id="explainer">Industry Track</h2>
      <p>
        Date & time: Tuesday 25 May, 9:30 - 17:00 CET.
      </p>
      <p style="margin-block-end: 0;">
        The morning program will be open to anyone with a valid RustWeek ticket. Speakers include invited speaker Jess Izen.
      </p>
      <p style="margin-block-end: 0;">
        The afternoon is reserved for the Expert Table Sessions, where you can meet both your peers who are pursuing the same goals, and the experts who know the ins and outs of reaching those goals. To attend the Expert Tables in the afternoon, please make sure to buy the add-on "Industry Track Expert tables participation" when you register for RustWeek.
      </p>
    </div>
  </OneColumn>
  <OneColumn>
    <div class="markdown">
      <h2 id="schedule">Schedule</h2>
      <p><i>Details will be announced after the CfP closes and talks are selected in January 2027.</i></p>
      <p><b>Morning:</b> Talks, open to all</p>
      <p><b>Lunch:</b> Plenary</p>
      <p><b>Afternoon:</b> Expert Table sessions, exclusive to Industry Add-on ticket holders</p>
      <p><b>Drinks:</b> Plenary</p>
