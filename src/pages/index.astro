  <Image src="/images/rustweek2026/flags.jpg" alt="Flags at RustWeek 2026" />
  <Cta
    title="About RustWeek"
    lead="RustWeek is organised by RustNL, a non-profit that promotes the Rust programming language and support Rust's maintainers."
  >
    <ButtonGroup>
      <Button link="/about">More About Us</Button>
