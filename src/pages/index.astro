---
import HeroLayout from "../layouts/HeroLayout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Image from "../components/Image.astro";
import Speaker from "src/components/people/Speaker.astro";
import PeopleList from "src/components/people/PeopleList.astro";
import Location from "src/components/Location.astro";
import MainSchedule from "src/components/schedule/MainSchedule.astro";
import Sponsors from "src/components/sponsor/Sponsors.astro";
import SponsorTier from "src/components/sponsor/sponsor-tier.astro";
import Sponsor from "src/components/sponsor/sponsor.astro";
import { useData } from "../components/useData";
import { getCollection } from "astro:content";
import OneColumn from "src/components/OneColumn.astro";
import Cta from "src/components/Cta.astro";

const people = await getCollection("people");
const { greg, taylor, andreea, alice, waffle, aeva } = useData(people);
const speakers = [taylor, greg, andreea, alice, waffle, aeva];
---

<HeroLayout title="RustWeek 2027">
  <Fragment slot="hero">
    <div>
      <h1 class="font-display">RustWeek 2027</h1>
      <h2>May 24-29 — Utrecht, NL</h2>
    </div>
    <p>
      The world's biggest Rust conference includes one day of workshops, two
      days of talks, a hackathon, social activities, and more!
    </p>
    <ButtonGroup style="cutout" align="left">
      <Button link="#week-schedule" ty="secondary">Week schedule</Button>
      <Button link="https://event.onliveevent.nl/rustweek-2027">Tickets</Button>
    </ButtonGroup>
  </Fragment>
  <OneColumn>
    <div class="markdown">
      <h2 id="explainer">RustWeek 2027</h2>
      <p>
        RustWeek returns to beautiful Utrecht, welcoming over 950+ community
        members, professionals and the maintainers of Rust.
      </p>
      <p style="margin-block-end: 0;">
        The week includes one day of workshops, two days of talks, a hackathon,
        and social activities. Additionally, we're hosting an unconference, and
        our third Rust Project All Hands!
      </p>
    </div>
  </OneColumn>
  <MainSchedule />
  <PeopleList title="Last year's speakers" id="speakers" lead="" random={false}>
    {speakers.map((speaker: any) => <Speaker smalltile {...speaker} />)}
  </PeopleList>
  <div
    style="width: 100%; display: flex; flex-direction: column; align-items: center;"
  >
    <div
      style="display: flex; flex-direction: column; align-items: center; gap: 0.5em;"
    >
      And so many more!
      <Button link="https://2026.rustweek.org/speakers">
        All last year's speakers
      </Button>
    </div>
  </div>
  <OneColumn>
    <div class="markdown">
      <h2>Rust All Hands & Unconference</h2>
      <p>
        RustNL is proud to host the Rust All Hands for the 3rd time! At the All
        Hands, Rust Project members and invited guests work on Rust in person
        for several days, discuss its future, resolve blockers and build
        connections between teams and with other ecosystems.
      </p>
    </div>
  </OneColumn>
  <div class="pb-24">
      <!-- <Image
        src="/images/rustweek2026/welcome-allhands-2026.jpg"
        alt="Welcome sign at All Hands at RustWeek 2026"
      /> -->
      <Image
        src="/images/rustweek2026/allhands-2026.jpeg"
        alt="All Hands at RustWeek 2026"
      />
      <!-- <Image
        src="/images/rustweek2026/embroidery-allhands-2026.jpg"
        alt="Ferris embroidery at All Hands at RustWeek 2026"
      /> -->
  </div>
  <Location />
  <Sponsors id="sponsors">
    <div slot="header" class="markdown">
      <h2>Our sponsors from RustWeek 2026</h2>
      <p>
        Interested in sponsoring RustWeek 2027? <br />Download our <a
          target="_blank"
          href="/resources/sponsorship-prospectus-rustweek-2027.pdf"
          >Sponsorship prospectus</a
        > or <a href="mailto:sponsors@rustnl.org">contact us</a>
      </p>
    </div>
    <SponsorTier name="Diamond sponsors">
      <Sponsor
        name="AWS"
        tier="diamond"
        image="aws.png"
        link="https://aws.amazon.com/"
      />
    </SponsorTier>
    <SponsorTier name="Gold sponsors">
      <Sponsor
        name="Jetbrains"
